pipeline {
    agent any
    
    tools {
        maven "3.9.2"
    }
    
    environment {
        VERSION = "1.0.${BUILD_NUMBER}"
        DB_URL = "jdbc:postgresql://postgres:5432/webbooks"
        DB_USER = "postgres"
        DB_PASSWORD = "password"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                dir('apps/webbooks') {
                    sh "mvn clean package -DDB.url=${DB_URL} -DDB.user=${DB_USER} -DDB.password=${DB_PASSWORD} -DskipTests"
                }
            }
        }
        
        stage('Test') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest()
                }
            }
            steps {
                dir('apps/webbooks') {
                    sh "mvn test -DDB.url=${DB_URL} -DDB.user=${DB_USER} -DDB.password=${DB_PASSWORD}"
                }
            }
            post {
                always {
                    junit 'apps/webbooks/target/surefire-reports/TEST-*.xml'
                }
            }
        }
        
        stage('Archive Artifacts') {
            when {
                branch 'main'
            }
            steps {
                archiveArtifacts artifacts: 'apps/webbooks/target/*.jar', fingerprint: true
            }
        }
        
        stage('Trigger Deploy Pipeline') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Запускаем отдельный pipeline для деплоя
                    def deployJob = build job: 'webbooks-deploy', 
                        parameters: [
                            string(name: 'ARTIFACT_NAME', value: "digital-library-${VERSION}.jar"),
                            string(name: 'BUILD_NUMBER', value: "${BUILD_NUMBER}")
                        ],
                        wait: true
                    
                    echo "Deploy pipeline completed with result: ${deployJob.result}"
                }
            }
        }
    }
    
    post {
        always {
            // Очистка workspace
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}